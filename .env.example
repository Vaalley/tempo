# Docker Compose credentials and database settings
POSTGRES_USER=tempo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tempo_db
MONGO_INITDB_ROOT_USERNAME=tempo
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_DB_NAME=tempo_audit

# Internal Docker network connection strings
DATABASE_URL=postgres://tempo:change-me-postgres@postgres:5432/tempo_db
MONGO_URL=mongodb://tempo:change-me-mongo@mongo:27017/?authSource=admin

# Required application secret (replace with a long random value)
JWT_SECRET=replace-with-a-long-random-secret

# HTTP security
FRONTEND_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false

# Frontend API URL
PUBLIC_API_URL=http://localhost:3000

# Optional reproducible demo data (required only for the demo seed command)
DEMO_ADMIN_EMAIL=admin@tempo.test
DEMO_ADMIN_PASSWORD=change-me-demo-admin
DEMO_USER_EMAIL=user@tempo.test
DEMO_USER_PASSWORD=change-me-demo-user
