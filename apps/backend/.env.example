DATABASE_URL="postgres://tempo:change-me-postgres@localhost:5432/tempo_db"
MONGO_URL="mongodb://tempo:change-me-mongo@localhost:27017/?authSource=admin"
MONGO_DB_NAME="tempo_audit"
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_ORIGIN="http://localhost:5173"
AUTH_RATE_LIMIT_MAX="10"
