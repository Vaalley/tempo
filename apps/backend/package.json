{
	"name": "@tempo/backend",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "bun run --bun tsc --noEmit",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"test": "bun test --path-ignore-patterns='**/integration/**'",
		"test:integration:postgres": "RUN_POSTGRES_INTEGRATION=true bun test src/integration/postgres-bookings.integration.spec.ts",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.24",
		"mongodb": "^7.2.0",
		"pg": "^8.21.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	}
}
