{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --bun vite dev",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview",
		"prepare": "bun run --bun svelte-kit sync || echo ''",
		"check": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "bun run check",
		"check:watch": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "bun run --bun vitest",
		"test": "bun run --bun vitest --run"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.575.0",
		"@tempo/backend": "workspace:*",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"hono": "^4.12.24",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.0.3",
		"@types/pg": "^8.20.0",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.56.3",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
